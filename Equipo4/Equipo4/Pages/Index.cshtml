@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}
<link rel="stylesheet" href="~/css/Index.css"/>

<div class="layout">
    <div class="Productos">
        @foreach (var p in Model.Productos)
        {
            <div class="tarjeta">
                <img src="@p.ImagenUrl" alt="@p.Nombre" />
                <hr/>
                <small>@p.Sku</small>
                <h3>@p.Nombre</h3>
                <p>@p.Precio.ToString("C")</p> <!-- Currency -->
                <form method="post" asp-page-handler="Agregar">
                    <input type="hidden" name="sku" value="@p.Sku" />
                    <button type="submit" class="btn">Agregar al carrito</button>
                </form>
            </div>
        }
    </div>
    @if (Model.Carrito.Items != null && Model.Carrito.Items.Any())
    {
        <div class="carrito">
            <div class="carrito-encabezado">
                <img src="/images/carrito_compras.png" alt="Carrito de compras"/>
                <h1>Carrito</h1>
            </div>
            <hr>
            <div class="carrito-productos">
                @foreach (var item in Model.Carrito.Items)
                {
                    <div class="linea">
                        <img src="@item.Producto.ImagenUrl" alt="@item.Producto.Nombre" />
                        <span>@item.Producto.Nombre</span>
                        <span>Cantidad: @item.Cantidad</span>
                        <span>c/u: @item.Subtotal</span>
                        <span>@item.Subtotal.ToString("C")</span>
                        <form method="post" asp-page-handler="Quitar">
                            <input type="hidden" name="sku" value="@item.Producto.Sku" />
                            <button type="submit" class="btn">Quitar</button>
                        </form>
                    </div>
                }
            </div>
            <hr>
            <div class="carrito-subtotal">
                <p>
                    Subtotal: $0.00
                </p>
            </div>
            <div class="carrito-total">
                <p><b>
                        Total: $0.00
                </b></p>
            </div>
            <hr>
            <button type="submit" class="btn">Proceder al pago</button>
        </div>
    }
</div>